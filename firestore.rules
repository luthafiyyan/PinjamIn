rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email == "hafiyyanluthfii@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.terverifikasi == true)
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      // User can read their own profile, admin can read all
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Create profile: new users can create their own profile with role "peminjam" and terverifikasi false
      allow create: if isOwner(userId) && (
        isAdmin() || (
          request.resource.data.role == "peminjam" &&
          request.resource.data.terverifikasi == false &&
          request.resource.data.email == request.auth.token.email
        )
      );

      // Update profile: peminjam hanya boleh mengubah field: nomorHp, unitAsal, angkatan, dan permintaanPerubahan
      // Field nama, nomorIdentitas, tipePeminjam, terverifikasi, email, dan createdAt tidak boleh diubah oleh peminjam
      // Admin (isAdmin() berdasarkan email) boleh mengubah semua field
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nomorHp', 'unitAsal', 'angkatan', 'permintaanPerubahan'])
      );

      allow delete: if isAdmin();
    }

    // CATEGORIES
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // SETTINGS
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ITEMS
    match /items/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // LOANS
    match /loans/{loanId} {
      // Peminjam hanya boleh membaca peminjaman miliknya sendiri, Admin boleh membaca semua
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );

      // Create: verified user creating loan for themselves, or admin
      allow create: if isAdmin() || (
        isVerifiedUser() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.peminjam.email == request.auth.token.email &&
        request.resource.data.status == "menunggu_persetujuan" &&
        request.resource.data.itemIds is list &&
        request.resource.data.itemIds.size() > 0 &&
        request.resource.data.itemIds.size() <= 10 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() == request.resource.data.itemIds.size() &&
        request.resource.data.tglPinjam is string &&
        request.resource.data.tglRencanaKembali is string &&
        request.resource.data.tglRencanaKembali >= request.resource.data.tglPinjam
      );

      // Update & Delete: admin can update loan status (e.g. approve, handover, returns)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // BOOKINGS (Sanitized calendar booking slots without PII - UU PDP compliance)
    match /bookings/{bookingId} {
      // Pengguna terautentikasi dapat melihat jadwal slot booking untuk cek ketersediaan alat
      allow read: if isSignedIn();

      // Dibuat bersamaan secara atomik saat peminjaman diajukan
      allow create: if isAdmin() || (
        isVerifiedUser() &&
        request.resource.data.loanId == bookingId &&
        request.resource.data.itemIds is list &&
        request.resource.data.itemIds.size() > 0 &&
        request.resource.data.itemIds.size() <= 10 &&
        request.resource.data.status == "menunggu_persetujuan"
      );

      // Admin dapat memperbarui, membuat, atau menghapus status booking
      allow write: if isAdmin();
    }

    // INVOICES
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      // Create together with loan
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // COUNTERS
    match /counters/{counterId} {
      allow read: if isSignedIn();
      // Validasi penambahan counter nomor invoice oleh user terverifikasi atau admin
      allow write: if (isVerifiedUser() || isAdmin()) &&
        request.resource.data.keys().hasOnly(['last']) &&
        request.resource.data.last is int &&
        (!exists(resource) || request.resource.data.last == resource.data.last + 1);
    }
  }
}
