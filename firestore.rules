rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function getUserTipe() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipePeminjam;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.superadmin == true ||
        request.auth.token.role in ['admin', 'superadmin'] ||
        (request.auth.token.email == "hafiyyanluthfii@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserRole() in ['admin', 'superadmin'])
      );
    }

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.superadmin == true ||
        request.auth.token.role == 'superadmin' ||
        (request.auth.token.email == "hafiyyanluthfii@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserRole() == 'superadmin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.terverifikasi == true)
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      // User can read their own profile, admin can read all
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Create profile: new users can create their own profile with role "peminjam" and terverifikasi false
      allow create: if isOwner(userId) && (
        isAdmin() || (
          request.resource.data.keys().hasOnly(['uid', 'email', 'nama', 'noHp', 'nomorHp', 'tipePeminjam', 'nomorIdentitas', 'unitAsal', 'angkatan', 'role', 'terverifikasi', 'createdAt']) &&
          request.resource.data.role == "peminjam" &&
          request.resource.data.nama is string && request.resource.data.nama.size() <= 100 &&
          request.resource.data.nomorIdentitas is string && request.resource.data.nomorIdentitas.size() <= 50 &&
          request.resource.data.terverifikasi == false &&
          request.resource.data.email == request.auth.token.email
        )
      );

      // Update profile:
      // - Superadmin boleh mengubah semua field termasuk peran ('role')
      // - Admin biasa boleh verifikasi / ubah data peminjam, tapi TIDAK BOLEH mengubah field 'role'
      // - Peminjam biasa hanya boleh mengubah nomorHp, unitAsal, angkatan, permintaanPerubahan
      allow update: if isSuperAdmin() || (
        isAdmin() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        )
      ) || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nomorHp', 'unitAsal', 'angkatan', 'permintaanPerubahan']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nomorHp']) || (request.resource.data.nomorHp is string && request.resource.data.nomorHp.size() <= 20)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['unitAsal']) || (request.resource.data.unitAsal is string && request.resource.data.unitAsal.size() <= 100)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['angkatan']) || (request.resource.data.angkatan is string && request.resource.data.angkatan.size() <= 10)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['permintaanPerubahan']) || request.resource.data.permintaanPerubahan is map || request.resource.data.permintaanPerubahan == null)
      );

      allow delete: if isSuperAdmin();
    }

    // CATEGORIES
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // SETTINGS
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ITEMS
    match /items/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // LOANS
    match /loans/{loanId} {
      // Peminjam hanya boleh membaca peminjaman miliknya sendiri, Admin boleh membaca semua
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );

      // Create: verified user creating loan for themselves, or admin
      allow create: if isAdmin() || (
        isVerifiedUser() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.peminjam.email == request.auth.token.email &&
        request.resource.data.status == "menunggu_persetujuan" &&
        request.resource.data.itemIds is list &&
        request.resource.data.itemIds.size() > 0 &&
        (
          (getUserTipe() == 'mahasiswa' && request.resource.data.itemIds.size() <= 2) ||
          (getUserTipe() in ['dosen', 'tendik'] && request.resource.data.itemIds.size() <= 5) ||
          (request.resource.data.itemIds.size() <= 2)
        ) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() == request.resource.data.itemIds.size() &&
        request.resource.data.tglPinjam is string &&
        request.resource.data.tglRencanaKembali is string &&
        request.resource.data.tglRencanaKembali >= request.resource.data.tglPinjam &&
        request.resource.data.keperluan is string &&
        request.resource.data.keperluan.size() <= 500
      );

      // Update & Delete: admin can update loan status (e.g. approve, handover, returns)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // BOOKINGS (Sanitized calendar booking slots without PII - UU PDP compliance)
    match /bookings/{bookingId} {
      // Pengguna terautentikasi dapat melihat jadwal slot booking untuk cek ketersediaan alat
      allow read: if isSignedIn();

      // Dibuat bersamaan secara atomik saat peminjaman diajukan
      allow create: if isAdmin() || (
        isVerifiedUser() &&
        request.resource.data.loanId == bookingId &&
        request.resource.data.itemIds is list &&
        request.resource.data.itemIds.size() > 0 &&
        (
          (getUserTipe() == 'mahasiswa' && request.resource.data.itemIds.size() <= 2) ||
          (getUserTipe() in ['dosen', 'tendik'] && request.resource.data.itemIds.size() <= 5) ||
          (request.resource.data.itemIds.size() <= 2)
        ) &&
        request.resource.data.status == "menunggu_persetujuan"
      );

      // Admin dapat memperbarui, membuat, atau menghapus status booking
      allow write: if isAdmin();
    }

    // INVOICES
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      // Create together with loan
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // COUNTERS
    match /counters/{counterId} {
      allow read: if isSignedIn();
      // Validasi penambahan counter nomor invoice oleh user terverifikasi atau admin
      allow create: if (isVerifiedUser() || isAdmin()) &&
        request.resource.data.keys().hasOnly(['last']) &&
        request.resource.data.last is int &&
        request.resource.data.last >= 1;
      allow update: if (isVerifiedUser() || isAdmin()) &&
        request.resource.data.keys().hasOnly(['last']) &&
        request.resource.data.last is int &&
        request.resource.data.last == resource.data.last + 1;
    }
  }
}
