rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "hafiyyanluthfii@gmail.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.terverifikasi == true)
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      // User can read their own profile, admin can read all
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Create profile: new users can create their own profile with role "peminjam" and terverifikasi false
      allow create: if isOwner(userId) && (
        isAdmin() || (
          request.resource.data.role == "peminjam" &&
          request.resource.data.terverifikasi == false &&
          request.resource.data.email == request.auth.token.email
        )
      );

      // Update profile: peminjam hanya boleh mengubah field: nomorHp, unitAsal, angkatan, dan permintaanPerubahan
      // Field nama, nomorIdentitas, tipePeminjam, terverifikasi, email, dan createdAt tidak boleh diubah oleh peminjam
      // Admin (isAdmin() berdasarkan email) boleh mengubah semua field
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nomorHp', 'unitAsal', 'angkatan', 'permintaanPerubahan'])
      );

      allow delete: if isAdmin();
    }

    // CATEGORIES
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // SETTINGS
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ITEMS
    match /items/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // LOANS
    match /loans/{loanId} {
      // Any signed in user can read loan schedules for calendar booking availability
      allow read: if isSignedIn();

      // Create: verified user creating loan for themselves, or admin
      allow create: if isAdmin() || (
        isVerifiedUser() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "menunggu_persetujuan" &&
        request.resource.data.itemIds is list &&
        request.resource.data.itemIds.size() > 0
      );

      // Update & Delete: admin can update loan status (e.g. approve, handover, returns)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // INVOICES
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      // Create together with loan
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // COUNTERS
    match /counters/{counterId} {
      allow read: if isSignedIn();
      // Any verified user or admin can update the invoice counter during loan transaction
      allow write: if isVerifiedUser() || isAdmin();
    }
  }
}
